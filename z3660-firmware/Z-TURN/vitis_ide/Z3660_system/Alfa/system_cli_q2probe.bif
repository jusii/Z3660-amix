/* Z3660 command-line boot image -- WARP M0 Q2 UNWIND-PROBE variant.
 *
 * Identical to system_cli.bif except for the core1 ELF: Z3660_emu/build-q2probe/ instead
 * of Z3660_emu/build/. Core0 (Z3660.elf), the FSBL and the bitstream are shared -- the
 * probe variant changes core1 only. Produced by `make q2probe` -> sd_card/BOOT-q2probe.BIN.
 *
 * This image is an EXPERIMENT, not a production one and not an instrument either. Its
 * core1 emits four ARM instructions into the heap, executes them, and deliberately
 * provokes a C++ unwind across them, to answer Plan WARP ENGINE's Q2 before any codegen
 * is written. It prints its verdict on serial before emulation starts, so one boot's
 * capture is the whole result. BOOT-lean.BIN is what goes back on the card afterwards.
 */
the_ROM_image:
{
  [bootloader] design_1_wrapper/zynq_fsbl/fsbl.elf
  design_1_wrapper/hw/design_1_wrapper.bit
  Z3660/build/Z3660.elf
  Z3660_emu/build-q2probe/Z3660_emu.elf
}
